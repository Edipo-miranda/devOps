# Copie este arquivo para ".env.local" e preencha com os dados do SEU projeto Supabase.
# Onde encontrar: Supabase > Project Settings > API Keys (e Data API para a URL).
#
# Use SOMENTE a chave pública ("Publishable key", começa com sb_publishable_,
# ou a antiga "anon public"). NUNCA coloque aqui a "Secret key" (sb_secret_)
# nem a "service_role": tudo que começa com VITE_ fica visível no navegador.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_COLE_AQUI
